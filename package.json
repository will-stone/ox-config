{
  "name": "@will-stone/ox-config",
  "version": "5.0.6",
  "private": false,
  "description": "My configs for Oxc tooling",
  "homepage": "https://github.com/will-stone/ox-config#readme",
  "bugs": {
    "url": "https://github.com/will-stone/ox-config/issues"
  },
  "license": "MIT",
  "author": "Will Stone",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/will-stone/ox-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt --check",
    "lint": "oxlint",
    "build": "tsdown --publint",
    "prepare": "husky",
    "oxlint-rule-checker": "node ./oxlint-rule-checker/oxlint-rule-checker.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@types/confusing-browser-globals": "catalog:",
    "confusing-browser-globals": "catalog:",
    "es-toolkit": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "globals": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-react": "catalog:",
    "husky": "catalog:",
    "nano-staged": "catalog:",
    "publint": "catalog:",
    "simple-git": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0"
    },
    "runtime": {
      "name": "node",
      "version": "24"
    }
  }
}
